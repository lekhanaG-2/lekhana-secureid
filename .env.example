PORT=3000
APP_ORIGIN=http://localhost:3000
# Set BOTH secrets to distinct random values (at least 32 characters) in Vercel.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
JWT_SECRET=
# Required on Vercel; use a pooled Postgres connection from Neon or another provider.
DATABASE_URL=
# Optional Google OAuth credentials. The core assignment works without Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
